ninja_required_version = 1.3
toolkit = llvm
machine = c64
format = prg
basedir = /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64
builddir = /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build

project = DarkCurlyNights64
config = /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/project-config.json
target = /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build/DarkCurlyNights64.prg
dbg_out = /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build/DarkCurlyNights64.prg.elf
python_exe = python3
java_exe = java
rc_exe = /Users/kjartan.bjorndal.michalsen/.vscode/extensions/rosc.vs64-2.6.2/tools/rc.py
rc_flags = --format cpp --config "$config"
build_flags = 
clang = /Users/kjartan.bjorndal.michalsen/Documents/llvm-mos/bin/mos-clang++
clangc = /Users/kjartan.bjorndal.michalsen/Documents/llvm-mos/bin/mos-clang

flags = 
asmflags = -Wall -g -c -fnonreentrant -O0 -x assembler-with-cpp --config mos-c64.cfg
cflags = -Wall -g -c -fnonreentrant -O0 -fno-limit-debug-info -fstandalone-debug -fno-discard-value-names --config mos-c64.cfg
cppflags = -std=gnu++20
ldflags = --config mos-c64.cfg
includes = -I /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64 -I /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build
defs = -DDEBUG -D__llvm__ -D__clang__

rule res
    command = $python_exe $rc_exe $rc_flags -o $out $in

rule cpp
    depfile = $out.d
    deps = gcc
    command = $clang -MD -MF $out.d $flags $cppflags $cflags $defs $includes -o $out $in

rule cc
    depfile = $out.d
    deps = gcc
    command = $clangc -MD -MF $out.d $flags $cflags $defs $includes -o $out $in

rule asm
    depfile = $out.d
    deps = gcc
    command = $clang $flags $asmflags $includes -o $out $in

rule link
    command = $clang $flags $ldflags -O0 -o $out $in


build /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build/src/main.o: cc /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/src/main.c

build $target | $dbg_out : link /Users/kjartan.bjorndal.michalsen/Documents/GitHub/DarkCurlyNights64/build/src/main.o

build all: phony $target
default all
